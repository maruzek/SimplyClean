# Source mapping for the live-action slots.
#
# The classmate's clips arrived with camera filenames (IMG_9305.MOV etc.), so instead of
# renaming or copying 150 MB of footage, the pipeline reads this mapping. `conform.sh`
# loads this file automatically when it exists.
#
# Paths are resolved relative to the PROJECT ROOT (the parent of footage/) unless
# absolute. If a slot is not listed here, conform.sh falls back to
# `footage/<slot>.mp4`, and finally to leaving the placeholder in place.
#
# ── WHAT EACH CLIP CONTAINS (verified by inspecting every frame) ────────────────
#   IMG_9305.MOV  3840x2160 @60 8.46s  wide shot: flat with an upturned chair and a
#                                      bottle on the floor; man walks in with both
#                                      hands on his head, despairing.  → the mess
#   IMG_9312.mov  3840x2160 @30 5.14s  handheld detail: hand gives a thumbs up over
#                                      clean parquet floor.          → cleaned / done
#   IMG_9310.MOV  3840x2160 @30 8.52s  low angle: man leans back against the wall,
#                                      hands behind his head, eyes shut, content.
#                                                                   → payoff / relaxed
#
# NOTE: all three are variable frame rate (iPhone) and two carry a 90° rotation flag;
# ffmpeg auto-rotates them to 3840x2160 landscape and conform.sh forces 30 fps CFR.

MESSY_SRC=incoming/IMG_9305.MOV
CLEAN_SRC=incoming/IMG_9312.mov
RELAXED_SRC=incoming/IMG_9310.MOV
